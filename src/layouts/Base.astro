---
import { EMAIL, socials } from '../data/site';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; theme?: 'paper' | 'sage' | 'mauve' | 'ink' | 'board' | 'mist'; page?: string; schema?: object[]; }
const {
  title = 'CBS MarketingLab | Student marketing organisation at CBS',
  description = 'CBS MarketingLab is a student-run marketing organisation at Copenhagen Business School. Case work, panel debates and speaker events with real brands.',
  theme = 'paper',
  page = 'home',
  schema = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Canonical follows the live site (astro.config `site` + `base`). Switch both when cbsmarketinglab.dk goes live.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(`${base}/`, Astro.site).href;
const ogImage = new URL(`${base}/og.jpg`, Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${home}#org`,
  name: 'CBS MarketingLab',
  alternateName: ['Marketing Lab', 'MarketingLab CBS'],
  legalName: 'Marketing Lab',
  url: home,
  logo: new URL(`${base}/apple-touch-icon.png`, Astro.site).href,
  email: EMAIL,
  description,
  identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: '46430336' },
  address: { '@type': 'PostalAddress', streetAddress: 'c/o CBS Students, Solbjerg Plads 3', postalCode: '2000', addressLocality: 'Frederiksberg', addressCountry: 'DK' },
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Copenhagen Business School', url: 'https://www.cbs.dk' },
  sameAs: socials.map((s) => s.href),
};
const site = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'CBS MarketingLab', url: home, publisher: { '@id': `${home}#org` }, inLanguage: 'en' };
const graph = [org, site, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:site_name" content="CBS MarketingLab" />
    <meta property="og:locale" content="en_DK" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CBS MarketingLab: marketers in the making" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#91bda6" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class={`theme-${theme}`}>
    <Header current={page} />
    <main id="main">
      <slot />
    </main>
    {page !== 'contact' && <Footer />}
  </body>
</html>
