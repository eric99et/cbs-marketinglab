---
import { SITE_URL } from '../data/site';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; theme?: 'paper' | 'sage' | 'mauve' | 'ink' | 'board' | 'mist'; page?: string; }
const {
  title = 'CBS MarketingLab | Marketers in the making',
  description = 'CBS MarketingLab is a student organisation at Copenhagen Business School building the next generation of marketers through events, courses and real company cases.',
  theme = 'paper',
  page = 'home',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = SITE_URL + Astro.url.pathname.replace(base, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta property="og:image" content={`${base}/img/logo.webp`} />
    <meta name="theme-color" content="#90BCA5" />
    <link rel="icon" href={`${base}/img/logo.webp`} />
  </head>
  <body class={`theme-${theme}`}>
    <Header current={page} />
    <main id="main">
      <slot />
    </main>
    {page !== 'contact' && <Footer />}
  </body>
</html>
