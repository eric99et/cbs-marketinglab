---
import { url, EMAIL, PARTNER_EMAIL, socials, DOMAIN } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const subject = encodeURIComponent('Partnership with MarketingLab');
---
<footer class="site-footer">
  <div class="wrap top">
    <a class="cta" href={url('contact/')}>
      <span class="big-word">Say hi <span class="arrow" aria-hidden="true">↗</span></span>
      <span class="hand">we don't bite (much)</span>
    </a>
    <nav class="cols" aria-label="Footer">
      <div class="col">
        <h2>Students</h2>
        <a href={url('join/')}>Join the lab</a>
        <a href={url('events/')}>Events</a>
        <a href={url('join/#faq')}>FAQ</a>
      </div>
      <div class="col">
        <h2>Companies</h2>
        <a href={url('partners/')}>Ways to partner</a>
        <a href={`mailto:${PARTNER_EMAIL}?subject=${subject}`}>Partnerships email</a>
      </div>
      <div class="col">
        <h2>Follow</h2>
        {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.name} ↗</a>)}
        <a href={url('contact/#news')}>Newsletter</a>
      </div>
    </nav>
  </div>

  <p class="giant" aria-hidden="true">Marketing Lab</p>

  <div class="wrap bottom">
    <Logo size={34} />
    <span>Solbjergvej 3, 3rd floor, 2000 Frederiksberg</span>
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <span>{DOMAIN}</span>
    <span>Non-profit student association · CVR 46430336</span>
    <span class="copy">© {year} CBS Marketing Lab</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--sage); color: var(--ink); padding-top: clamp(70px, 9vw, 120px); position: relative; z-index: 1; overflow: hidden; }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(40px, 6vw, 100px); align-items: start; }
  .cta { text-decoration: none; display: grid; justify-items: start; }
  .big-word { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(72px, 10vw, 160px); line-height: 0.85; transition: color 0.2s ease; }
  .arrow { display: inline-block; font-family: var(--f-body); font-size: 0.5em; vertical-align: top; color: var(--paper); transition: translate 0.25s ease; }
  .cta:hover .big-word { color: var(--paper); }
  .cta:hover .arrow { translate: 6px -6px; }
  .cta .hand { font-size: 40px; color: var(--aubergine); rotate: -3deg; margin-top: 4px; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; padding-top: 12px; }
  .col { display: grid; gap: 10px; align-content: start; border-top: 2px solid var(--ink); padding-top: 16px; }
  .col h2 { font-size: 18px; color: var(--aubergine); margin-bottom: 2px; }
  .col a { text-decoration: none; font-family: var(--f-display); text-transform: uppercase; font-size: 24px; line-height: 1.1; letter-spacing: .01em; width: fit-content; background: linear-gradient(var(--ink), var(--ink)) 0 100% / 0 2px no-repeat; transition: background-size 0.25s ease; }
  .col a:hover { background-size: 100% 2px; }
  .giant { margin: clamp(60px, 8vw, 110px) 0 0; font-family: var(--f-display); text-transform: uppercase; font-size: 16.6vw; line-height: 0.78; letter-spacing: -0.01em; white-space: nowrap; text-align: center; color: var(--paper); }
  .bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 26px; padding-block: 22px 26px; border-top: 1px solid rgba(0, 0, 0, 0.25); font-size: 14px; color: var(--ink); }
  .bottom :global(.ml-logo) { background: var(--ink); color: var(--paper); }
  .bottom a { color: inherit; text-underline-offset: 3px; }
  .bottom .copy { margin-left: auto; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; }
    .cols { grid-template-columns: 1fr 1fr; }
    .bottom .copy { margin-left: 0; }
  }
  @media (max-width: 480px) { .cols { grid-template-columns: 1fr; } }
</style>
