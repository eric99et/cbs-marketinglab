---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-footer" id="contact" data-bg="ink">
  <div class="wrap">
    <p class="chapter-tag">07 / SAY HI</p>
    <h2 class="big">Say hi.<br /><span class="mauve">We don't bite</span> <span class="hand small">(much)</span></h2>
    <div class="cols">
      <div>
        <p class="mono label">Write us</p>
        <a class="mail" href="mailto:general.marketinglab@gmail.com">general.marketinglab@gmail.com</a>
      </div>
      <div>
        <p class="mono label">Find us</p>
        <p>Solbjergvej 3, 3rd floor<br />2000 Frederiksberg</p>
      </div>
      <div>
        <p class="mono label">Follow the chaos</p>
        <ul class="socials">
          <li><a href="https://www.instagram.com/marketinglab/" target="_blank" rel="noopener">Instagram ↗</a></li>
          <li><a href="https://www.linkedin.com/company/marketinglab-copenhagen/" target="_blank" rel="noopener">LinkedIn ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="bottom mono">
      <img src={`${base}/img/logo.webp`} alt="CBS MarketingLab" width="40" height="40" />
      <span>Made with too much coffee at Solbjergvej 3 · © {year} CBS MarketingLab</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--paper); padding-block: clamp(80px, 12vw, 150px) 32px; position: relative; z-index: 1; }
  .mauve { color: var(--mauve); }
  .small { font-size: 0.32em; text-transform: none; color: var(--sage); vertical-align: middle; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 64px; }
  .label { color: var(--sage); margin-bottom: 10px; }
  .mail { font-size: clamp(18px, 2vw, 24px); word-break: break-all; text-decoration-color: var(--sage); text-underline-offset: 5px; }
  .socials { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .socials a { text-decoration: none; font-size: 20px; }
  .socials a:hover { color: var(--sage); }
  .bottom { display: flex; align-items: center; gap: 14px; margin-top: 80px; padding-top: 24px; border-top: 1px dashed rgba(252, 248, 240, 0.3); font-size: 11px; color: rgba(252, 248, 240, 0.7); }
  .bottom img { border-radius: 10px; }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr; } }
</style>
