---
import { url, img, EMAIL, PARTNER_EMAIL, socials } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <a class="cta" href={url('contact/')}>
      <span class="big-word">Say hi</span>
      <span class="hand">we don't bite (much) ↗</span>
    </a>
    <div class="meta">
      <p class="paths"><a href={url('join/')}>Students: join the lab ↗</a><a href={`mailto:${PARTNER_EMAIL}?subject=${encodeURIComponent('Partnership with MarketingLab')}`}>Companies: partner with us ↗</a><a href={url('contact/#news')}>Newsletter ↗</a></p>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <p>Solbjergvej 3, 3rd floor, 2000 Frederiksberg</p>
      <ul class="socials">
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.name} ↗</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap bottom">
    <Logo size={36} />
    <span>Made with too much coffee at Solbjergvej 3 · © {year} CBS MarketingLab</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--paper); padding-block: clamp(60px, 9vw, 110px) 28px; position: relative; z-index: 1; }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 40px; }
  .cta { text-decoration: none; display: grid; }
  .big-word { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(64px, 11vw, 170px); line-height: 0.85; transition: color 0.2s ease; }
  .cta:hover .big-word { color: var(--sage); }
  .cta .hand { font-size: 28px; color: var(--sage); }
  .meta { display: grid; gap: 8px; font-size: 16px; }
  .meta a { text-decoration-color: var(--sage); text-underline-offset: 4px; }
  .paths { display: grid; gap: 4px; margin-bottom: 10px; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(22px, 2vw, 28px); line-height: 1.1; }
  .paths a { text-decoration: none; }
  .paths a:hover { color: var(--sage); }
  .socials { list-style: none; display: flex; gap: 18px; padding: 0; margin: 6px 0 0; }
  .socials a { text-decoration: none; font-weight: 600; }
  .socials a:hover { color: var(--sage); }
  .bottom { display: flex; align-items: center; gap: 14px; margin-top: 60px; padding-top: 22px; border-top: 1px dashed rgba(252, 248, 240, 0.3); font-size: 13px; color: rgba(252, 248, 240, 0.7); }
</style>
