---
import { base, url, nav, img } from '../data/site';
import Arrow from './Arrow.astro';
import Logo from './Logo.astro';
const { current = 'home' } = Astro.props as { current?: string };
const links = nav.filter((l) => l.key !== 'home');
---
<header class="site-header" data-header>
  <a class="logo" href={url()} aria-label="CBS MarketingLab home">
    <Logo size={52} />
  </a>
  <a class="join hand" href={url("join/")}>Join us ↗</a>
  <button class="postit hand" type="button" aria-expanded="false" aria-controls="whiteboard" data-menu-open>
    menu
  </button>
</header>

<p class="toast mono" role="status" aria-live="polite" hidden data-toast></p>

<div class="whiteboard" id="whiteboard" role="dialog" aria-modal="true" aria-label="Menu" hidden data-whiteboard>
  <button class="wb-close mono" type="button" data-menu-close>close ✕</button>
  <p class="wb-scribble hand" aria-hidden="true">brainstorm, do not erase!!</p>
  <nav>
    <ul>
      {links.map((l, i) => (
        <li style={`--i:${i}`} class={l.key === current ? "is-current" : ""}>
          <a href={l.href} data-menu-link aria-current={l.key === current ? 'page' : undefined}>
            <span class="wb-word">{l.label}</span>
            <svg class="wb-circle" viewBox="0 0 300 110" preserveAspectRatio="none" aria-hidden="true">
              <path d="M18 62 C 14 22, 120 8, 210 14 C 290 20, 296 70, 250 92 C 190 112, 60 108, 26 84 C 6 70, 20 40, 60 30" />
            </svg>
          </a>
          <span class="wb-note hand" aria-hidden="true"><Arrow dir="left" />{l.note}</span>
        </li>
      ))}
    </ul>
  </nav>
  <div class="wb-ticket tape" aria-hidden="true">
    <span class="mono">admit one ✶</span>
    <strong>Next event</strong>
    <span class="mono">TBA · stay tuned</span>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 14px var(--gutter);
    transition: translate 0.35s ease;
    pointer-events: none;
  }
  .site-header > * { pointer-events: auto; }
  .site-header.is-hidden { translate: 0 -120%; }
  .logo { display: inline-block; transition: rotate 0.3s ease, scale 0.3s ease; }
  .logo:hover { rotate: -2deg; scale: 1.08; }
  .join {
    font-size: 26px;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    padding: 2px 14px;
    rotate: -1.2deg;
    border-bottom: 2px solid var(--ink);
  }
  .postit {
    justify-self: end;
    font-size: 24px;
    width: 86px;
    height: 74px;
    border: 0;
    background: var(--postit);
    color: var(--ink);
    rotate: 2deg;
    box-shadow: 0 10px 24px rgba(32, 32, 32, 0.12);
    cursor: pointer;
    transition: rotate 0.2s ease, scale 0.2s ease;
    clip-path: polygon(0 0, 100% 0, 100% 82%, 86% 100%, 0 100%);
  }
  .postit:hover { rotate: -1.8deg; scale: 1.06; }

  .toast { position: fixed; z-index: 90; left: 50%; bottom: 24px; translate: -50% 140%; max-width: calc(100vw - 32px); margin: 0; padding: 14px 18px; background: var(--ink); color: var(--paper); border: 2px solid var(--sage); box-shadow: 5px 5px 0 var(--sage); text-transform: none; letter-spacing: 0.02em; font-size: 14px; transition: translate 0.35s ease; }
  .toast.is-on { translate: -50% 0; }
  .whiteboard {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: #fbfbf8;
    background-image: radial-gradient(rgba(32, 32, 32, 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    border: clamp(10px, 2vw, 18px) solid #d9d9d4;
    padding: clamp(80px, 12vh, 120px) var(--gutter) 40px;
    overflow-y: auto;
    clip-path: circle(0% at calc(100% - 60px) 50px);
    transition: clip-path 0.6s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .whiteboard.is-open { clip-path: circle(150% at calc(100% - 60px) 50px); }
  .wb-close { position: absolute; top: 24px; right: var(--gutter); background: none; border: 1.5px solid var(--ink); padding: 8px 12px; cursor: pointer; color: var(--ink); }
  .wb-scribble { position: absolute; top: 28px; left: var(--gutter); font-size: 22px; color: var(--mauve); rotate: -1.8deg; }
  .whiteboard ul { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(4px, 1.5vh, 18px); }
  .whiteboard li { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 18px; opacity: 0; translate: -30px 0; transition: opacity 0.4s ease, translate 0.4s ease; transition-delay: calc(0.25s + var(--i) * 0.07s); }
  .whiteboard.is-open li { opacity: 1; translate: 0 0; }
  .whiteboard li:nth-child(even) { padding-left: clamp(20px, 8vw, 120px); }
  .whiteboard li a { position: relative; text-decoration: none; color: #1d3a8a; }
  .wb-word { font-family: var(--f-hand); font-size-adjust: 0.4; line-height: 1.05; font-size: clamp(46px, 8.4vw, 104px); line-height: 1.05; padding-inline: 0.12em; }
  .wb-circle { position: absolute; left: -16%; top: -18%; width: 132%; height: 150%; fill: none; stroke: var(--mauve); stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: 900; stroke-dashoffset: 900; transition: stroke-dashoffset 0.5s ease; pointer-events: none; }
  .whiteboard li a:hover .wb-circle, .whiteboard li a:focus-visible .wb-circle { stroke-dashoffset: 0; }
  .whiteboard li.is-current .wb-circle { stroke-dashoffset: 0; stroke: var(--sage-dk); }
  .wb-note { display: inline-flex; align-items: center; gap: 10px; font-size: clamp(20px, 2.4vw, 28px); color: var(--ink-soft); line-height: 1; }
  .wb-ticket {
    position: absolute;
    right: clamp(16px, 6vw, 80px);
    bottom: clamp(24px, 8vh, 80px);
    display: grid;
    gap: 4px;
    padding: 18px 26px;
    background: var(--sage);
    color: var(--ink);
    rotate: 2deg;
    border: 2px dashed var(--ink);
  }
  .wb-ticket strong { font-family: var(--f-display); font-weight: 400; font-size: 34px; text-transform: uppercase; line-height: 1; }
  @media (max-width: 720px) {
    .join { font-size: 22px; padding: 2px 10px; }
    .postit { width: 70px; height: 60px; font-size: 20px; }
    .wb-ticket { position: static; margin-top: 40px; justify-self: start; width: max-content; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const board = document.querySelector<HTMLElement>('[data-whiteboard]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  // header hides on scroll down, returns on scroll up
  let lastY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    header.classList.toggle('is-hidden', y > lastY && y > 120);
    lastY = y;
  }, { passive: true });

  const open = () => {
    board.hidden = false;
    requestAnimationFrame(() => board.classList.add('is-open'));
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  };
  const close = () => {
    board.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => { board.hidden = true; }, 600);
    openBtn.focus();
  };
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  board.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
  // mail links open another app; drop focus so no ring is left behind on return
  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  let toastT = 0;
  const showToast = (msg: string) => { toast.textContent = msg; toast.hidden = false; requestAnimationFrame(() => toast.classList.add('is-on')); clearTimeout(toastT); toastT = window.setTimeout(() => toast.classList.remove('is-on'), 4200); };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.('a[href^="mailto:"]') as HTMLAnchorElement | null;
    if (!a) return;
    const addr = decodeURIComponent(a.href.slice(7).split('?')[0]);
    navigator.clipboard?.writeText(addr).then(() => showToast(`Opening your email app. Address copied: ${addr}`), () => showToast(`Opening your email app. Our address: ${addr}`));
    setTimeout(() => a.blur(), 0);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !board.hidden) close(); });
</script>
