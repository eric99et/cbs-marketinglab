---
// CONTACT: a postcard on the desk. Stamps for socials, a message you "post".
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { img, socials, EMAIL } from '../data/site';
const year = new Date().getFullYear();
---
<Base page="contact" theme="ink" title="Say hi | CBS MarketingLab">
  <section class="wrap page-top head">
    <h1 class="page-title">
      <span class="line" data-split>Say hi.</span>
    </h1>
    <p class="hand bite">we don't bite (much)</p>
  </section>

  <section class="wrap desk">
    <div class="postcard" data-card>
      <div class="pc-left">
        <p class="hand pc-label">greetings from Frederiksberg</p>
        <form class="msg" data-msg>
          <label><span class="visually-hidden">Your message</span><textarea name="msg" rows="7" required placeholder="Dear MarketingLab, ..."></textarea></label>
          <label><span class="visually-hidden">Your name</span><input name="name" required placeholder="Love, (your name)" /></label>
          <button class="btn" type="submit">Post it ↗</button>
        </form>
      </div>
      <div class="pc-right">
        <div class="stamp-box"><Logo size={110} /><span class="mono">DKK 0,00</span></div>
        <div class="postmark" aria-hidden="true"><span class="pm-box mono">Frederiksberg<br />Solbjergvej 3</span><svg viewBox="0 0 160 60"><path d="M0 10 Q 10 2 20 10 T 40 10 T 60 10 T 80 10 T 100 10 T 120 10 T 140 10 T 160 10" /><path d="M0 30 Q 10 22 20 30 T 40 30 T 60 30 T 80 30 T 100 30 T 120 30 T 140 30 T 160 30" /><path d="M0 50 Q 10 42 20 50 T 40 50 T 60 50 T 80 50 T 100 50 T 120 50 T 140 50 T 160 50" /></svg></div>
        <address class="addr">
          <span>CBS MarketingLab</span>
          <span>Solbjergvej 3, 3rd floor</span>
          <span>2000 Frederiksberg</span>
          <span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></span>
        </address>
      </div>
    </div>

    <div class="stamps">
      {socials.map((s, i) => (
        <a class={`social-stamp st${i}`} href={s.href} target="_blank" rel="noopener">
          <strong>{s.name}</strong>
          <span>{s.handle} ↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap news" id="news">
    <form class="newsletter" data-news>
      <label class="news-title" for="nl">Get the good stuff first.</label>
      <p class="hand">No spam, we're too busy.</p>
      <div class="nl-row">
        <input id="nl" type="email" required placeholder="you@student.cbs.dk" autocomplete="email" />
        <button class="btn" type="submit">Lock it in</button>
      </div>
      <p class="hand thanks" data-thanks hidden>Got it. (The newsletter tool gets connected soon, so nothing was sent yet.)</p>
    </form>
  </section>

  <p class="wrap bottom">Made with too much coffee at Solbjergvej 3 · © {year} CBS MarketingLab</p>
</Base>

<style>
  .head { padding-bottom: 30px; }
  .bite { font-size: clamp(34px, 4vw, 60px); color: var(--sage); rotate: -1.8deg; margin-top: -0.2em; }
  .desk { padding-block: 40px 80px; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .postcard { background: var(--paper); color: var(--ink); display: grid; grid-template-columns: 1.2fr 1fr; gap: 0; padding: clamp(22px, 3vw, 40px); rotate: -0.9deg; box-shadow: 0 10px 24px rgba(32, 32, 32, 0.12); background-image: linear-gradient(90deg, transparent calc(55% - 1px), rgba(32, 32, 32, 0.3) calc(55% - 1px), rgba(32, 32, 32, 0.3) 55%, transparent 55%); }
  .pc-left { padding-right: clamp(18px, 3vw, 40px); display: grid; gap: 14px; align-content: start; }
  .pc-label { font-size: 26px; color: var(--sage-dk); }
  .msg { display: grid; gap: 14px; }
  textarea, input { width: 100%; font-family: var(--f-body); font-size: 19px; line-height: 34px; color: #1d3a8a; background: repeating-linear-gradient(transparent 0 33px, rgba(32, 32, 32, 0.2) 33px 34px); border: 0; padding: 0 4px; resize: none; }
  input { height: 40px; }
  textarea:focus, input:focus { outline: none; background-color: rgba(144, 188, 165, 0.15); }
  .msg .btn { justify-self: start; }
  .pc-right { position: relative; padding-left: clamp(18px, 3vw, 40px); display: grid; align-content: space-between; min-height: 340px; }
  .stamp-box { justify-self: end; display: grid; justify-items: center; gap: 4px; padding: 8px; background: #fff; border: 3px dotted var(--mauve); rotate: 2deg; font-size: 10px; }
  .postmark { position: absolute; right: 70px; top: 80px; display: flex; align-items: center; gap: 6px; color: rgba(164, 136, 136, 0.95); rotate: -2deg; }
  .pm-box { border: 2px solid currentColor; padding: 6px 10px; font-size: 10px; line-height: 1.3; text-align: center; }
  .postmark svg { width: 120px; height: 46px; fill: none; stroke: currentColor; stroke-width: 2; }
  .addr { font-style: normal; display: grid; font-family: var(--f-hand); font-size-adjust: 0.4; line-height: 1.05; font-size: clamp(22px, 2vw, 30px); line-height: 1.5; }
  .addr span { border-bottom: 1px solid rgba(32, 32, 32, 0.3); }
  .addr a { color: #1d3a8a; font-size: 0.8em; word-break: break-all; }
  .stamps { display: grid; gap: 22px; }
  .social-stamp { display: grid; gap: 6px; padding: 18px; text-decoration: none; color: var(--ink); background: var(--sage); border: 4px dotted var(--ink); rotate: 1.8deg; transition: rotate 0.2s ease, scale 0.2s ease; }
  .social-stamp:hover { rotate: -1.2deg; scale: 1.05; }
  .social-stamp.st1 { background: var(--mauve); rotate: -2deg; }
  .social-stamp strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: 26px; line-height: 1; }
  .news { padding-block: 40px 80px; }
  .newsletter { display: grid; gap: 8px; max-width: 760px; }
  .news-title { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(40px, 5vw, 76px); line-height: 0.95; }
  .newsletter .hand { font-size: 26px; color: var(--sage); }
  .nl-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 14px; }
  .nl-row input { flex: 1 1 260px; font-family: var(--f-body); font-size: 18px; line-height: normal; height: auto; padding: 14px 16px; border: 2px solid var(--paper); background: transparent; color: var(--paper); }
  .nl-row .btn { background: var(--sage); color: var(--ink); border-color: var(--sage); box-shadow: 5px 5px 0 var(--mauve); }
  .bottom { padding-bottom: 30px; font-size: 11px; color: rgba(252, 248, 240, 0.6); }
  @media (max-width: 900px) {
    .desk, .postcard { grid-template-columns: 1fr; }
    .postcard { background-image: none; }
    .pc-left { padding-right: 0; padding-bottom: 24px; border-bottom: 1px solid rgba(32, 32, 32, 0.3); }
    .pc-right { padding-left: 0; padding-top: 20px; min-height: 0; gap: 20px; }
    .postmark { right: 130px; top: 10px; }
    .stamps { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  import { gsap, reduce, splitLines, allBasics } from '../scripts/motion';
  splitLines();
  allBasics();
  if (!reduce) {
    gsap.from('[data-card]', { y: 200, rotation: -12, opacity: 0, duration: 1.1, delay: 0.3, ease: 'power3.out' });
    gsap.from('.social-stamp', { scale: 2.2, opacity: 0, rotation: 30, duration: 0.5, stagger: 0.15, delay: 1, ease: 'power4.in' });
  }
  const msg = document.querySelector<HTMLFormElement>('[data-msg]')!;
  msg.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(msg);
    location.href = `mailto:general.marketinglab@gmail.com?subject=${encodeURIComponent('Hi from ' + d.get('name'))}&body=${encodeURIComponent(String(d.get('msg')) + '\n\n' + d.get('name'))}`;
  });
  const news = document.querySelector<HTMLFormElement>('[data-news]')!;
  news.addEventListener('submit', (e) => { e.preventDefault(); news.querySelector<HTMLElement>('[data-thanks]')!.hidden = false; });
</script>
