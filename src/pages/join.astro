---
// JOIN: whiteboard after a brainstorm. Marker words, sticky notes, a checklist that ticks itself.
import Base from '../layouts/Base.astro';
import { perks, faq, EMAIL, img } from '../data/site';
const steps = [
  { n: '1', title: 'Apply', text: 'Two minutes. Tell us who you are.' },
  { n: '2', title: 'Coffee chat', text: 'A relaxed talk with the team. No trick questions.' },
  { n: '3', title: "You're in", text: 'Welcome to the lab. First meeting is on us.' },
];
const teams = ['Partnerships', 'Operations', 'Marketing', 'Digital', 'Finance', 'Not sure yet'];
---
<Base page="join" theme="board" title="Join us | CBS MarketingLab">
  <section class="wrap page-top hero">
    <div>
      <h1 class="title">
        <span class="line" data-split>Your CV</span>
        <span class="line" data-split>called.</span>
      </h1>
      <p class="marker hand">It wants this. <svg viewBox="0 0 300 40" class="underline" data-draw aria-hidden="true"><path d="M4 30 C 80 10, 200 8, 296 22" /></svg></p>
      <p class="lede">Don't just join another student organisation. Help us build something from the ground up and leave your mark on a growing CBS community.</p>
      <a class="btn" href="#apply">Apply now ↓</a>
    </div>
    <div class="checklist lined tape" data-checklist>
      <p class="hand cl-title">why join?</p>
      <ul>
        {perks.map((p) => (
          <li><span class="box" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13 L 10 19 L 21 5" /></svg></span>{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap steps" aria-labelledby="steps-title">
    <h2 id="steps-title" class="sec">how it works</h2>
    <ol class="flow">
      {steps.map((s, i) => (
        <li>
          <span class="circle-n">{s.n}<svg viewBox="0 0 100 100" data-draw aria-hidden="true"><path d="M52 5 C 78 5, 95 24, 95 50 C 95 76, 76 95, 50 95 C 24 95, 5 76, 5 50 C 5 26, 22 7, 46 6 C 52 6, 58 7, 62 9" /></svg></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {i < steps.length - 1 && <svg class="flow-arrow" viewBox="0 0 64 28" data-draw aria-hidden="true"><path d="M3 17 C 16 9, 30 22, 44 13 C 50 9, 55 11, 60 13" /><path d="M50 4 C 54 8, 57 10, 61 13 C 56 16, 53 19, 50 24" /></svg>}
        </li>
      ))}
    </ol>
  </section>

  <section id="apply" class="wrap apply" aria-labelledby="apply-title">
    <figure class="apply-pol tape" aria-hidden="true"><img src={img('stock-students')} alt="" loading="lazy" /><figcaption class="hand">future you, probably</figcaption></figure>
    <div class="paper tape">
      <h2 id="apply-title" class="apply-title">Application</h2>
      <p class="hand apply-note">fill it in, hit send, we'll take it from there</p>
      <form class="form" data-apply>
        <label><span>Name</span><input name="name" required autocomplete="name" /></label>
        <label><span>CBS email</span><input name="email" type="email" required autocomplete="email" placeholder="you@student.cbs.dk" /></label>
        <label><span>Programme &amp; semester</span><input name="programme" placeholder="e.g. BSc IBP, 3rd semester" /></label>
        <fieldset>
          <legend>Which team?</legend>
          <div class="chips">
            {teams.map((t) => <label class="chip"><input type="radio" name="team" value={t} /><span>{t}</span></label>)}
          </div>
        </fieldset>
        <label class="wide"><span>Why MarketingLab? (be honest, be weird)</span><textarea name="why" rows="4" required></textarea></label>
        <button class="btn" type="submit">Send it ↗</button>
        <p class="small">Opens your email app with your answers. A proper form is coming soon.</p>
      </form>
    </div>
  </section>

  <section id="faq" class="wrap faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="sec">questions people actually ask</h2>
    <div class="notes">
      {faq.map((f, i) => (
        <details class={`note n${i % 4}`}>
          <summary class="hand">{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 6vw, 90px); align-items: center; padding-bottom: clamp(60px, 9vw, 110px); }
  .title { font-size: clamp(72px, 12vw, 200px); line-height: 0.84; color: #1d3a8a; }
  .title .line { display: block; overflow: hidden; }
  .marker { position: relative; display: inline-block; font-size: clamp(44px, 6vw, 92px); color: #c0392b; rotate: -3deg; margin: 6px 0 34px; }
  .underline { position: absolute; left: 0; bottom: -8px; width: 100%; height: 30px; fill: none; stroke: #c0392b; stroke-width: 4; stroke-linecap: round; }
  .hero .lede { margin-bottom: 28px; }
  .lined { background: #fff repeating-linear-gradient(transparent 0 35px, #cfd9e6 35px 36px); background-position: 0 18px; }
  .checklist { padding: 34px 34px 26px 54px; rotate: 2deg; box-shadow: 0 14px 30px rgba(32, 32, 32, 0.16); border-left: 2px solid rgba(192, 57, 43, 0.4); }
  .cl-title { font-size: 44px; line-height: 1; margin-bottom: 8px; }
  .checklist ul { list-style: none; margin: 0; padding: 0; }
  .checklist li { font-family: var(--f-hand); font-size-adjust: 0.4; font-size: 27px; line-height: 36px; display: flex; gap: 12px; align-items: center; }
  .box { width: 22px; height: 22px; border: 2px solid var(--ink); display: inline-grid; flex: none; }
  .box svg { fill: none; stroke: var(--sage-dk); stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: 30; stroke-dashoffset: 30; transition: stroke-dashoffset 0.35s ease; overflow: visible; }
  .checklist li.is-ticked .box svg { stroke-dashoffset: 0; }

  .sec { font-size: clamp(40px, 5vw, 72px); color: #1d3a8a; margin-bottom: 40px; }
  .steps { padding-block: clamp(50px, 7vw, 90px); }
  .flow { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .flow li { position: relative; display: grid; gap: 10px; align-content: start; }
  .circle-n { position: relative; width: 96px; height: 96px; display: grid; place-items: center; font-family: var(--f-display); font-size: 52px; line-height: 1; padding-top: 0.06em; }
  .circle-n svg { position: absolute; inset: 0; fill: none; stroke: #c0392b; stroke-width: 3; stroke-linecap: round; }
  .flow h3 { font-size: clamp(34px, 3.4vw, 52px); }
  .flow-arrow { position: absolute; right: -6px; top: 34px; width: 80px; fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }

  .apply { padding-block: clamp(50px, 7vw, 90px); display: grid; grid-template-columns: minmax(0, 900px) minmax(0, 1fr); gap: clamp(30px, 4vw, 60px); align-items: start; }
  .apply .paper { grid-row: 1; grid-column: 1; }
  .apply-pol { grid-column: 2; grid-row: 1; margin: 60px 0 0; background: #fff; padding: 10px 10px 12px; rotate: 4deg; box-shadow: 0 14px 30px rgba(32, 32, 32, 0.16); }
  .apply-pol img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .apply-pol figcaption { font-size: 26px; color: #c0392b; margin-top: 4px; }
  @media (max-width: 1100px) { .apply { grid-template-columns: 1fr; } .apply-pol { display: none; } }
  .paper { background: #fff; padding: clamp(26px, 4vw, 56px); box-shadow: 0 18px 40px rgba(32, 32, 32, 0.14); rotate: -0.6deg; max-width: 900px; }
  .apply-title { font-size: clamp(56px, 7vw, 110px); }
  .apply-note { font-size: 28px; color: var(--sage-dk); margin-bottom: 30px; }
  .form { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 26px; }
  .form label { display: grid; gap: 6px; }
  .form .wide, .form fieldset, .form .btn, .form .small { grid-column: 1 / -1; }
  .form .btn { justify-self: start; }
  input, textarea { font: inherit; font-size: 17px; padding: 12px 2px; border: 0; border-bottom: 2px solid var(--ink); background: transparent; color: var(--ink); border-radius: 0; }
  textarea { border: 2px solid var(--ink); padding: 12px; resize: vertical; }
  input:focus, textarea:focus { outline: none; border-color: var(--sage-dk); background: rgba(144, 188, 165, 0.12); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip input { position: absolute; opacity: 0; }
  .chip span { display: inline-block; padding: 8px 16px; border: 2px solid var(--ink); border-radius: 999px; cursor: pointer; font-family: var(--f-mono); font-size: 14px; transition: background 0.15s ease, rotate 0.15s ease; }
  .chip input:checked + span { background: var(--sage); rotate: -3deg; }
  .chip input:focus-visible + span { outline: 2px dashed var(--ink); outline-offset: 3px; }
  .small { font-size: 14px; color: var(--ink-soft); }

  .faq { padding-block: clamp(50px, 7vw, 90px) clamp(80px, 10vw, 140px); }
  .notes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 26px; align-items: start; }
  .note { padding: 22px 20px 26px; box-shadow: 2px 8px 14px rgba(0, 0, 0, 0.15); min-height: 170px; }
  .note summary { font-size: 30px; line-height: 1.1; cursor: pointer; list-style: none; }
  .note summary::-webkit-details-marker { display: none; }
  .note summary::after { content: ' +'; color: #c0392b; }
  .note[open] summary::after { content: ' −'; }
  .note p { margin-top: 12px; font-size: 16px; }
  .n0 { background: var(--postit); rotate: -3deg; }
  .n1 { background: #f9c6c9; rotate: 2deg; }
  .n2 { background: #c9e4d6; rotate: -1deg; }
  .n3 { background: #cfe0f7; rotate: 3deg; }
  @media (max-width: 900px) {
    .hero, .flow, .form { grid-template-columns: 1fr; }
    .flow-arrow { display: none; }
    .notes { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .notes { grid-template-columns: 1fr; } }
</style>

<script>
  import { reduce, splitLines, allBasics, ScrollTrigger } from '../scripts/motion';
  splitLines();
  allBasics();
  const items = document.querySelectorAll<HTMLElement>('[data-checklist] li');
  ScrollTrigger.create({
    trigger: '[data-checklist]',
    start: 'top 85%',
    once: true,
    onEnter: () => items.forEach((li, i) => setTimeout(() => li.classList.add('is-ticked'), reduce ? 0 : 600 + i * 320)),
  });

  const form = document.querySelector<HTMLFormElement>('[data-apply]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const body = `Name: ${d.get('name')}\nEmail: ${d.get('email')}\nProgramme: ${d.get('programme') || '-'}\nTeam: ${d.get('team') || '-'}\n\nWhy MarketingLab:\n${d.get('why')}`;
    window.location.href = `mailto:${'general.marketinglab@gmail.com'}?subject=${encodeURIComponent('Application: ' + d.get('name'))}&body=${encodeURIComponent(body)}`;
  });
</script>
