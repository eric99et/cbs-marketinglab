---
// ABOUT: people first. Sage hero with the board as tall portrait columns,
// a black vision band, values as big ruled rows, teams as colour stripes.
import Base from '../layouts/Base.astro';
import { url, img, board, MEMBERS, teams as teamNames, vision, values } from '../data/site';
const teamLines: Record<string, string> = {
  Partnerships: 'Brings in the brands and the briefs.',
  Operations: 'Makes every event happen.',
  Marketing: 'Makes the posters you stop for.',
  Digital: 'Builds the site you’re on.',
  Finance: 'Keeps the lab (and the pizza) paid for.',
};
const shots = [
  { src: 'event-bold-talk', alt: 'AI in marketing talk with Bold Scandinavia at Station', note: 'AI in marketing, Oct 2026' },
  { src: 'stock-workshop', alt: 'Students working on a case together', note: '' },
  { src: 'dinner', alt: 'Station Community Dinner with Bold Scandinavia and NoA', note: 'community dinner' },
  { src: 'listening', alt: 'A student listening to a case presentation', note: '' },
  { src: 'team-collage', alt: 'MarketingLab board introductions on Instagram', note: 'the board, 2026' },
];
const stripe = ['var(--sage-dk)', 'var(--mauve)', 'var(--moss)', 'var(--aubergine)', 'var(--ink)'];
---
<Base page="about" theme="paper" title="About us: 21 CBS students, one lab | CBS MarketingLab" description="Meet CBS MarketingLab: the board, our five teams and what we stand for. A student organisation bringing CBS students and the marketing industry together.">
  <section class="hero">
    <div class="wrap hero-in">
      <h1 class="big">
        <span class="line" data-split><span class="n">{MEMBERS}</span> students.</span>
        <span class="line" data-split>One lab.</span>
      </h1>
      <p class="sub">CBS students working on real marketing problems, with the brands that have them.</p>
    </div>
    <ul class="cols wrap" aria-label="The board">
      {board.map((b) => (
        <li class="col" data-col>
          <div class="pic">
            {b.photo
              ? <img src={img(b.photo)} alt={b.name} loading="lazy" />
              : <span class="ini" aria-hidden="true">{b.name.split(' ').map((w) => w[0]).join('')}</span>}
          </div>
          <strong>{b.name}</strong>
          <span>{b.role}</span>
          {b.linkedin && <a href={b.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="vision" aria-label="Our vision">
    <div class="wrap"><p><span class="hand">our vision</span>{vision}</p></div>
  </section>

  <section class="life" aria-label="Life in the lab">
    <ul class="wrap shots">
      {shots.map((s, i) => (
        <li class={`shot s${i}`}>
          <img src={img(s.src)} alt={s.alt} loading="lazy" />
          {s.note && <span class="hand">{s.note}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap vals" aria-labelledby="v-title">
    <h2 id="v-title" class="h2">What we stand for</h2>
    <ol class="val-list">
      {values.map((v, i) => (
        <li>
          <span class="vn">0{i + 1}</span>
          <strong>{v.title}</strong>
          <span class="vt">{v.text}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="teams" aria-labelledby="t-title">
    <div class="wrap t-head">
      <h2 id="t-title" class="h2">Five teams</h2>
      <a class="btn" href={url('join/')}>Join one ↗</a>
    </div>
    <ul class="stripes">
      {teamNames.map((name, i) => (
        <li style={`--c:${stripe[i % stripe.length]}`} data-stripe>
          <strong>{name}</strong>
          <span>{teamLines[name] ?? ''}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { background: var(--sage); padding-top: clamp(120px, 14vw, 180px); padding-bottom: clamp(60px, 7vw, 100px); }
  .big { font-size: clamp(64px, 11vw, 190px); line-height: 0.86; margin: 0; }
  .big .line { display: block; overflow: hidden; }
  .big .n { color: var(--paper); }
  .sub { max-width: 34ch; font-size: clamp(18px, 1.5vw, 22px); margin: 28px 0 0; }

  .cols { list-style: none; margin-top: clamp(50px, 6vw, 90px); padding-top: 0; padding-bottom: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px); align-items: start; }
  .col:nth-child(even) { margin-top: clamp(30px, 4vw, 70px); }
  .pic { aspect-ratio: 3 / 4; overflow: hidden; background: var(--paper); margin-bottom: 14px; }
  .pic img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter 0.3s ease, scale 0.4s ease; }
  .col:hover .pic img { filter: none; scale: 1.04; }
  .col .ini { display: grid; margin: 0; place-items: center; width: 100%; height: 100%; font-family: var(--f-display); font-size: clamp(56px, 6vw, 96px); color: var(--sage-dk); }
  .col strong { display: block; font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(20px, 1.7vw, 26px); line-height: 1; }
  .col span { display: block; font-size: 15px; margin-top: 4px; }
  .col a { display: inline-block; font-size: 15px; margin-top: 6px; }

  .vision { background: var(--ink); color: var(--paper); padding-block: clamp(70px, 9vw, 130px); }
  .vision p { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(40px, 6.4vw, 112px); line-height: 0.92; margin: 0; max-width: 20ch; }
  .vision .hand { display: block; color: var(--sage); font-size: clamp(40px, 4vw, 64px); margin-bottom: 10px; }

  .life { padding-top: clamp(70px, 9vw, 120px); }
  .shots { list-style: none; display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr 1fr; gap: clamp(12px, 1.6vw, 22px); align-items: end; }
  .shot { position: relative; margin: 0; }
  .shot img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: grayscale(1); transition: filter 0.3s ease; }
  .shot:hover img { filter: none; }
  .shot .hand { display: block; font-size: 24px; color: var(--sage-dk); margin-top: 6px; }
  .s0, .s2, .s4 { rotate: -1deg; } .s1, .s3 { rotate: 1deg; translate: 0 -18px; }
  .s0::before, .s2::before { content: ''; position: absolute; z-index: 2; top: -12px; left: 50%; width: 80px; height: 24px; translate: -50% 0; rotate: -3deg; background: var(--tape); }
  .h2 { font-size: clamp(48px, 7vw, 110px); margin: 0 0 36px; }
  .vals { padding-block: clamp(80px, 10vw, 140px); }
  .val-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .val-list li { display: grid; grid-template-columns: 80px minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px; align-items: center; padding: 26px 0; border-bottom: 2px solid var(--ink); transition: background 0.2s ease, padding 0.2s ease; }
  .val-list li:hover { background: var(--sage-lt); padding-inline: 18px; }
  .vn { font-family: var(--f-display); font-size: 28px; color: var(--mauve); }
  .val-list strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(34px, 4vw, 64px); line-height: 1; }
  .vt { font-size: 18px; }

  .teams { padding-bottom: clamp(80px, 10vw, 140px); }
  .t-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 36px; }
  .t-head .h2 { margin: 0; }
  .stripes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); height: clamp(380px, 46vw, 620px); }
  .stripes li { background: var(--c); color: var(--paper); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding: 24px; transform-origin: bottom; transition: flex 0.3s ease; }
  .stripes strong { position: absolute; left: 24px; top: 24px; writing-mode: vertical-rl; rotate: 180deg; font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(44px, 5vw, 86px); line-height: 0.9; }
  .stripes span { font-size: 16px; max-width: 18ch; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .s4 { display: none; }
    .col:nth-child(even) { margin-top: 40px; }
    .val-list li { grid-template-columns: 48px 1fr; }
    .vt { grid-column: 2; }
    .stripes { grid-template-columns: 1fr; height: auto; }
    .stripes li { min-height: 120px; }
    .stripes strong { position: static; writing-mode: horizontal-tb; rotate: 0deg; font-size: 44px; margin-bottom: 6px; }
  }
</style>

<script>
  import { gsap, reduce, splitLines, allBasics } from '../scripts/motion';
  splitLines();
  if (!reduce) {
    gsap.from('[data-col] .pic', { clipPath: 'inset(100% 0 0 0)', duration: 1.1, stagger: 0.1, delay: 0.35, ease: 'power4.out' });
    gsap.to('.hero .col:nth-child(even)', { y: -50, ease: 'none', scrollTrigger: { trigger: '.hero .cols', start: 'top 80%', end: 'bottom top', scrub: true } });
    gsap.from('[data-stripe]', { scaleY: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out', scrollTrigger: { trigger: '.stripes', start: 'top 80%' } });
  }
  allBasics();
</script>
