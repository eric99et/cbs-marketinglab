---
import Base from '../layouts/Base.astro';
import { img, url, partners, past } from '../data/site';
const latest = past[0];
---
<Base page="home" theme="paper">
  <!-- HERO: collage -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <h1 id="hero-title" class="hero-title" style={`--photo:url(${img('dinner')})`}>
        <span class="line" data-split>Marketers</span>
        <span class="line" data-split>in the</span>
        <span class="line accent" data-split>making.</span>
      </h1>
      <p class="hero-note hand">some of us already made it →</p>
      <p class="hero-lede">A student organisation at Copenhagen Business School where the most curious marketers meet the brands, agencies and people shaping the industry.</p>
      <div class="hero-cta">
        <a class="btn" href={url('events/')}>See our events ↘</a>
        <a class="btn ghost" href={url('join/')}>Join the Lab</a>
      </div>
    </div>

    <div class="collage" aria-hidden="true">
      <figure class="pol p1" data-drop><img src={img('dinner')} alt="" /></figure>
      <figure class="pol p2" data-drop><img src={img('moth')} alt="" /></figure>
      <figure class="pol p3 bw" data-drop><img src={img('listening')} alt="" /></figure>
      <svg class="sketch-arrow" viewBox="0 0 220 140" data-hero-draw>
        <path d="M200 20 C 150 10, 90 30, 70 80 S 40 125, 18 120" />
        <path d="M30 104 L 16 121 L 38 128" />
      </svg>
      <p class="sketch-label hand">event photo here</p>
      <div class="stamp mono">MARKETING<br />✶ LAB ✶<br />CBS</div>
    </div>
  </section>

  <!-- PARTNER TAPES: two bands crossing, running opposite ways -->
  <div class="tapes" aria-label="Brands we've worked with">
    <div class="tape-band band-a" aria-hidden="true">
      <div class="band-track">
        {[...partners, ...partners].map((p, i) => <span class={i % 2 ? 'outline' : ''}>{p}<i class="blob"></i></span>)}
      </div>
    </div>
    <div class="tape-band band-b" aria-hidden="true">
      <div class="band-track reverse">
        {[...partners, ...partners].map(() => <span class="hand-item">worked with us, would do it again ✶</span>)}
      </div>
    </div>
    <ul class="visually-hidden">{partners.map((p) => <li>{p}</li>)}</ul>
  </div>

  <!-- DOORS: one door per page, each in that page's style -->
  <section class="doors wrap" aria-labelledby="doors-title">
    <h2 id="doors-title" class="doors-title">Pick a door.</h2>
    <p class="hand doors-note">(they're all good doors)</p>
    <div class="door-grid">
      <a class="door door-about" href={url('about/')}>
                <strong>Since 2012.</strong>
        <span class="door-line">Turning CBS students into people brands call back.</span>
        <span class="door-go">read the story →</span>
      </a>
      <a class="door door-events" href={url('events/')}>
        <span class="hand door-ticket">admit one ✶</span>
        <strong>Things you'll regret skipping</strong>
        <img src={img(latest.photo)} alt="" loading="lazy" />
        <span class="door-go">see the highlight reel →</span>
      </a>
      <a class="door door-partners" href={url('partners/')}>
                <strong>Got a brief?</strong>
        <span class="stickers" aria-hidden="true"><i>Bold</i><i>L'Oréal</i><i>DEPT</i><i>+8</i></span>
        <span class="door-go">meet the brands →</span>
      </a>
      <a class="door door-join" href={url('join/')}>
        <span class="hand door-hand">why join?</span>
        <span class="door-list hand">☑ real cases<br />☑ new friends<br />☐ your name here</span>
        <strong>Your CV called.</strong>
        <span class="door-go">apply →</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; padding-top: 120px; padding-bottom: 80px; overflow: hidden; }
  .hero-inner { position: relative; z-index: 2; }
  .hero-kicker { margin-bottom: 18px; color: var(--sage-dk); }
  .hero-title { font-size: clamp(76px, 17.5vw, 300px); line-height: 0.84; }
  .hero-title .line { display: block; overflow: hidden; }
  .hero-title .accent:not(:has(span)), .hero-title .accent > :global(span) {
    background: var(--photo) center 30% / cover, var(--ink);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: clamp(2px, 0.35vw, 5px) var(--ink);
    filter: saturate(1.15) brightness(0.9) contrast(1.15);
  }
  .hero-note { font-size: clamp(24px, 3vw, 38px); color: var(--sage-dk); rotate: -3deg; margin-top: 10px; }
  .hero-lede { max-width: 46ch; font-size: clamp(17px, 1.5vw, 20px); color: var(--ink-soft); margin-top: 20px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 30px; }
  .collage { position: absolute; z-index: 1; top: 90px; right: var(--gutter); width: min(46vw, 640px); height: min(78vh, 720px); pointer-events: none; }
  .pol { position: absolute; margin: 0; background: #fff; padding: 10px 10px 30px; box-shadow: 0 12px 28px rgba(32, 32, 32, 0.18); }
  .pol figcaption { position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: var(--ink-soft); }
  .pol img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .p1 { width: 44%; right: 8%; top: 4%; rotate: 5deg; }
  .p2 { width: 34%; right: 46%; top: 22%; rotate: -7deg; }
  .p3 { width: 38%; right: 18%; top: 48%; rotate: 2deg; }
  .bw img { filter: grayscale(1) contrast(1.08); }
  .sketch-arrow { position: absolute; width: 130px; right: 2%; top: 84%; scale: 1 -1; fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .sketch-label { position: absolute; right: 0; top: 100%; font-size: 26px; white-space: nowrap; rotate: -3deg; }
  .stamp { position: absolute; right: 4%; top: 58%; width: 110px; height: 110px; border-radius: 50%; border: 2px solid var(--mauve); color: var(--mauve); display: grid; place-items: center; text-align: center; font-size: 11px; line-height: 1.4; rotate: 14deg; background: rgba(252, 248, 240, 0.75); animation: spin 22s linear infinite; }
  @keyframes spin { to { rotate: 374deg; } }
  @media (max-width: 900px) {
    .collage { position: relative; top: auto; width: 100%; height: 420px; margin-top: 40px; }
    .hero { padding-bottom: 40px; }
  }

  /* PARTNER TAPES */
  .tapes { position: relative; height: clamp(190px, 22vw, 280px); margin-top: 20px; overflow: hidden; }
  .tape-band { position: absolute; left: -10vw; width: 120vw; top: 50%; overflow: hidden; box-shadow: 0 10px 24px rgba(32, 32, 32, 0.18); }
  .band-a { background: var(--ink); color: var(--paper); rotate: -4deg; translate: 0 -62%; z-index: 2; padding: 18px 0; }
  .band-b { background: var(--sage); color: var(--ink); rotate: 3deg; translate: 0 -10%; z-index: 1; padding: 10px 0; }
  .band-track { display: flex; align-items: center; gap: 36px; width: max-content; animation: band 40s linear infinite; white-space: nowrap; }
  .band-track.reverse { animation-direction: reverse; animation-duration: 55s; }
  .tapes:hover .band-track { animation-play-state: paused; }
  .band-track span { display: inline-flex; align-items: center; gap: 36px; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(34px, 4.6vw, 64px); line-height: 1; }
  .band-track span.outline { color: transparent; -webkit-text-stroke: 1.5px var(--paper); }
  .band-track .hand-item { font-family: var(--f-hand); font-weight: 600; text-transform: none; font-size: clamp(24px, 2.6vw, 34px); }
  .blob { display: inline-block; width: 0.42em; height: 0.36em; background: var(--sage); border-radius: 60% 40% 55% 45% / 55% 60% 40% 45%; rotate: 20deg; }
  @keyframes band { to { translate: -50% 0; } }

  /* DOORS */
  .doors { padding-block: clamp(100px, 14vw, 180px); }
  .doors-title { font-size: clamp(64px, 11vw, 180px); }
  .doors-note { font-size: 30px; color: var(--sage-dk); margin: 4px 0 50px; rotate: -2deg; }
  .door-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 32px); align-items: start; }
  .door { position: relative; display: grid; gap: 14px; min-height: 380px; padding: 24px; text-decoration: none; transition: rotate 0.3s ease, translate 0.3s ease, box-shadow 0.3s ease; box-shadow: 0 12px 26px rgba(32, 32, 32, 0.14); align-content: start; }
  .door strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(32px, 3vw, 46px); line-height: 0.92; }
  .door-go { margin-top: auto; align-self: end; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .door-ticket { font-size: 26px; color: var(--sage); }
  .door:hover { rotate: 0deg !important; translate: 0 -10px; box-shadow: 0 22px 40px rgba(32, 32, 32, 0.22); }
  .door-about { background: var(--sage); rotate: -2deg; }
  .door-about strong { font-size: clamp(48px, 5vw, 76px); }
  .door-events { background: var(--ink); color: var(--paper); rotate: 2deg; border: 2px dashed var(--sage); margin-top: 40px; }
  .door-events img { aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1); transition: filter 0.5s ease; }
  .door-events:hover img { filter: none; }
  .door-events strong { color: var(--sage); }
  .door-partners { background: var(--mauve); rotate: -1deg; }
  .stickers { display: flex; flex-wrap: wrap; gap: 8px; }
  .stickers i { font-style: normal; font-family: var(--f-display); text-transform: uppercase; padding: 8px 14px; border-radius: 999px; border: 3px solid #fff; background: var(--paper); box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15); }
  .stickers i:nth-child(2) { background: var(--postit); rotate: 6deg; }
  .stickers i:nth-child(3) { background: var(--ink); color: var(--paper); rotate: -5deg; }
  .door-join { background: #fff repeating-linear-gradient(transparent 0 31px, #cfd9e6 31px 32px); rotate: 3deg; margin-top: 20px; border-left: 2px solid rgba(192, 57, 43, 0.45); }
  .door-hand { font-size: 36px; line-height: 1; }
  .door-list { font-size: 26px; line-height: 32px; }
  @media (max-width: 1000px) { .door-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .door-grid { grid-template-columns: 1fr; } .door { min-height: 0; margin-top: 0 !important; } }
</style>

<script>
  import { gsap, reduce, splitLines, allBasics } from '../scripts/motion';
  const tl = splitLines();
  if (!reduce) {
    tl.from('[data-drop]', { y: -260, rotation: () => gsap.utils.random(-25, 25), opacity: 0, duration: 0.9, stagger: 0.12, ease: 'back.out(1.4)' }, 0.25);
    const arrow = document.querySelectorAll<SVGPathElement>('[data-hero-draw] path');
    arrow.forEach((p) => { const l = p.getTotalLength(); gsap.set(p, { strokeDasharray: l, strokeDashoffset: l }); });
    tl.to(arrow, { strokeDashoffset: 0, duration: 0.8, stagger: 0.3, ease: 'power2.inOut' }, 1.1);
    const st = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('.hero-title .accent > span', { backgroundPosition: 'center 70%', ease: 'none', scrollTrigger: st });
    gsap.to('.p1', { yPercent: -30, ease: 'none', scrollTrigger: st });
    gsap.to('.p3', { yPercent: -60, ease: 'none', scrollTrigger: st });
    gsap.from('.door', { y: 120, opacity: 0, rotation: () => gsap.utils.random(-12, 12), duration: 0.9, stagger: 0.12, ease: 'back.out(1.3)', scrollTrigger: { trigger: '.door-grid', start: 'top 80%' } });
  }
  allBasics();
</script>
