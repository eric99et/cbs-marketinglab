---
import Base from '../layouts/Base.astro';
import { img, url, partners, past, upcoming, socials, gcal, MEMBERS } from '../data/site';
const next = upcoming[0];
const latest = past[0];
---
<Base page="home" theme="paper">
  <!-- HERO: giant word, cut-out crew in front, a taped card with the essentials -->
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">Marketers in the making</h1>
    <p class="hero-word" aria-hidden="true"><span class="line" data-word>{"Marketers".split("").map((c) => <span class="ch">{c}</span>)}</span></p>
    <img class="hero-crew" src={img('cutout-crew')} alt="" data-crew />
    <div class="hero-card tape" data-drop>
      <p class="card-title" aria-hidden="true">in the <span>making.</span></p>
      <p class="hero-lede">Case work, panel debates and speaker events at Copenhagen Business School, with the people behind today's brands.</p>
      <div class="hero-cta">
        <a class="btn" href={url('events/')}>See our events</a>
        <a class="btn ghost" href={url('partners/')}>For companies</a>
      </div>
    </div>
    <figure class="hero-pol" data-drop aria-hidden="true">
      <img src={img('dinner')} alt="" />
      <figcaption class="hand">some of us already made it</figcaption>
    </figure>
  </section>
  <!-- PARTNERS: rolling tape -->
  <div role="region" class="strip" aria-label="Brands we've worked with">
    <p class="strip-label hand">worked with</p>
    <div class="strip-window" aria-hidden="true">
      <div class="strip-track">
        {[...partners, ...partners].map((p) => <span>{p}</span>)}
      </div>
    </div>
    <ul class="visually-hidden">{partners.map((p) => <li>{p}</li>)}</ul>
  </div>

  <!-- PROOF: numbers + next event -->
  <section class="proof wrap" aria-label="MarketingLab in numbers">
    <dl class="nums">
      <div><dd><span data-count="14">0</span></dd><dt>years on campus</dt></div>
      <div><dd><span data-count={MEMBERS}>0</span></dd><dt>members, five teams</dt></div>
      <div><dd><span data-count={partners.length}>0</span></dd><dt>brands we've worked with</dt></div>
    </dl>
    <div class="next tape">
      <span class="hand next-tag">next up</span>
      {next ? (
        <>
          <strong>{next.title}</strong>
          <span>{next.date} · {next.place}</span>
          <a class="btn" href={gcal(next as any)} target="_blank" rel="noopener">Add to calendar</a>
        </>
      ) : (
        <>
          <strong>Coming soon</strong>
          <span>New events are announced on Instagram first.</span>
          <a class="btn" href={socials[0].href} target="_blank" rel="noopener">Follow @marketinglab ↗</a>
        </>
      )}
    </div>
  </section>

  <!-- DOORS: one door per page, each in that page's style -->
  <section class="doors wrap" aria-labelledby="doors-title">
    <h2 id="doors-title" class="doors-title">Pick a door.</h2>
    <p class="hand doors-note">(they're all good doors)</p>
    <div class="door-grid">
      <a class="door door-about" href={url('about/')}>
                <strong>Since 2012.</strong>
        <span class="door-line">Turning CBS students into people brands call back.</span>
        <span class="door-go">read the story →</span>
      </a>
      <a class="door door-events" href={url('events/')}>
        <span class="hand door-ticket">admit one ✶</span>
        <strong>Things you'll regret skipping</strong>
        <img src={img(latest.photo)} alt="" loading="lazy" />
        <span class="door-go">see the highlight reel →</span>
      </a>
      <a class="door door-partners" href={url('partners/')}>
                <strong>Got a brief?</strong>
        <span class="stickers" aria-hidden="true"><i>Bold</i><i>L'Oréal</i><i>DEPT</i><i>+8</i></span>
        <span class="door-go">meet the brands →</span>
      </a>
      <a class="door door-join" href={url('join/')}>
        <span class="hand door-hand">why join?</span>
        <span class="door-list hand">☑ real cases<br />☑ new friends<br />☐ your name here</span>
        <strong>Your CV called.</strong>
        <span class="door-go">apply →</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: max(100svh, 680px); background: var(--sage); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding-top: 100px; padding-bottom: 40px; }
  .hero-word { position: absolute; left: 0; right: 0; top: clamp(90px, 13vh, 130px); margin: 0; text-align: center; font-family: var(--f-display); text-transform: uppercase; font-size: 22.6vw; line-height: 0.8; color: var(--paper); white-space: nowrap; z-index: 0; }
  .hero-word .line { display: block; overflow: hidden; padding-top: 0.04em; }
  .hero-word .ch { display: inline-block; }
  .hero-crew { position: absolute; z-index: 1; left: 50%; bottom: 0; translate: -50% 0; width: min(94vw, 1240px, calc((100svh - 120px) * 1.77)); height: auto; }
  .hero-card { position: absolute; z-index: 3; left: var(--gutter); bottom: 90px; width: min(440px, 36vw); background: var(--paper); padding: 26px 28px 28px; rotate: -2.5deg; box-shadow: 0 18px 40px rgba(32, 32, 32, 0.25); }
  .card-title { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(44px, 4.6vw, 72px); line-height: 0.9; }
  .card-title span { color: var(--sage-dk); }
  .hero-lede { font-size: clamp(16px, 1.25vw, 18px); line-height: 1.5; margin-top: 14px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
  .hero-cta .btn { font-size: 13px; padding: 12px 16px; }
  .hero-pol { position: absolute; z-index: 3; right: var(--gutter); bottom: 110px; width: min(230px, 18vw); margin: 0; background: #fff; padding: 9px 9px 12px; rotate: 6deg; box-shadow: 0 14px 30px rgba(32, 32, 32, 0.25); }
  .hero-pol img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .hero-pol figcaption { font-size: 20px; line-height: 1.1; margin-top: 6px; color: var(--sage-dk); }
  @media (max-width: 900px) {
    .hero { min-height: 0; padding-top: calc(90px + 21vw); }
    .hero-word { top: 90px; }
    .hero-crew { position: relative; left: 0; bottom: 0; translate: none; width: 116%; margin-left: -8%; margin-top: -4vw; }
    .hero-card { position: relative; left: auto; bottom: auto; width: auto; margin: -40px var(--gutter) 30px; }
    .hero-pol { display: none; }
  }

  /* PARTNER STRIP */
  .strip { position: relative; z-index: 2; display: flex; align-items: center; gap: 22px; width: 104vw; margin: -38px 0 0 -2vw; padding: 14px var(--gutter); background: var(--ink); color: var(--paper); rotate: -1.6deg; box-shadow: 0 10px 24px rgba(32, 32, 32, 0.22); }
  .strip::before, .strip::after { content: ''; position: absolute; top: -12px; width: 90px; height: 26px; background: var(--tape); rotate: 4deg; }
  .strip::before { left: 12%; } .strip::after { right: 14%; rotate: -5deg; }
  .strip-label { flex: none; font-size: clamp(24px, 2.2vw, 32px); color: var(--sage); padding-left: 3%; line-height: 1; }
  .strip-window { flex: 1; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .strip-track { display: flex; width: max-content; animation: strip 40s linear infinite; }
  .strip:hover .strip-track { animation-play-state: paused; }
  .strip-track span { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(26px, 2.6vw, 40px); line-height: 1; padding-inline: 26px; white-space: nowrap; position: relative; }
  .strip-track span::after { content: '✶'; position: absolute; right: -10px; top: 50%; font-family: var(--f-body); font-size: 0.55em; color: var(--sage); translate: 0 -50%; }
  .strip-track span:nth-child(3n+2) { color: var(--sage); }
  @keyframes strip { to { translate: -50% 0; } }
  @media (max-width: 560px) { .strip-label { display: none; } }


  /* PROOF */
  .proof { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: clamp(30px, 5vw, 70px); align-items: center; padding-block: clamp(90px, 11vw, 150px) 0; }
  .nums { display: grid; grid-template-columns: 1fr 1.35fr 1fr; gap: 32px; margin: 0; }
  .nums div { border-top: 3px solid var(--ink); padding-top: 14px; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 8px; }
  .nums dd { margin: 0; font-family: var(--f-display); font-size: clamp(56px, 6vw, 100px); line-height: 0.9; white-space: nowrap; }
  .nums div:nth-child(2) dd { color: var(--sage-dk); }
  .nums dt { font-size: 16px; }
  .next { display: grid; gap: 8px; justify-items: start; background: var(--postit); padding: 26px 26px 28px; rotate: 2.5deg; box-shadow: 0 14px 30px rgba(32, 32, 32, 0.16); }
  .next-tag { font-size: 28px; line-height: 1; color: #c0392b; }
  .next strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(36px, 3.4vw, 52px); line-height: 0.95; }
  .next .btn { margin-top: 8px; }
  @media (max-width: 900px) { .proof { grid-template-columns: 1fr; } .nums dd { font-size: 15vw; } }
  @media (max-width: 520px) { .nums { grid-template-columns: 1fr; } }

  /* DOORS */
  .doors { padding-block: clamp(100px, 14vw, 180px); }
  .doors-title { font-size: clamp(64px, 11vw, 180px); }
  .doors-note { font-size: 30px; color: var(--sage-dk); margin: 4px 0 50px; rotate: -2deg; }
  .door-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 32px); align-items: start; }
  .door { position: relative; display: grid; gap: 14px; min-height: 380px; padding: 24px; text-decoration: none; transition: rotate 0.3s ease, translate 0.3s ease, box-shadow 0.3s ease; box-shadow: 0 12px 26px rgba(32, 32, 32, 0.14); align-content: start; }
  .door strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(32px, 3vw, 46px); line-height: 0.92; }
  .door-go { margin-top: auto; align-self: end; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .door-ticket { font-size: 26px; color: var(--sage); }
  .door:hover { rotate: 0deg !important; translate: 0 -10px; box-shadow: 0 22px 40px rgba(32, 32, 32, 0.22); }
  .door-about { background: var(--sage); rotate: -2deg; }
  .door-about strong { font-size: clamp(48px, 5vw, 76px); }
  .door-events { background: var(--ink); color: var(--paper); rotate: 2deg; border: 2px dashed var(--sage); margin-top: 40px; }
  .door-events img { aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1); transition: filter 0.5s ease; }
  .door-events:hover img { filter: none; }
  .door-events strong { color: var(--sage); }
  .door-partners { background: var(--mauve); rotate: -1deg; }
  .stickers { display: flex; flex-wrap: wrap; gap: 8px; }
  .stickers i { font-style: normal; font-family: var(--f-display); text-transform: uppercase; padding: 8px 14px; border-radius: 999px; border: 3px solid #fff; background: var(--paper); box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15); }
  .stickers i:nth-child(2) { background: var(--postit); rotate: 6deg; }
  .stickers i:nth-child(3) { background: var(--ink); color: var(--paper); rotate: -5deg; }
  .door-join { background: #fff repeating-linear-gradient(transparent 0 31px, #cfd9e6 31px 32px); rotate: 3deg; margin-top: 20px; border-left: 2px solid rgba(192, 57, 43, 0.45); }
  .door-hand { font-size: 36px; line-height: 1; }
  .door-list { font-size: 26px; line-height: 32px; }
  @media (max-width: 1000px) { .door-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .door-grid { grid-template-columns: 1fr; } .door { min-height: 0; margin-top: 0 !important; } }
</style>

<script>
  import { gsap, reduce, splitLines, allBasics } from '../scripts/motion';
  const tl = splitLines();
  if (!reduce) {
    tl.from('.hero-word .ch', { yPercent: 115, rotation: () => gsap.utils.random(-14, 14), duration: 0.8, stagger: 0.05, ease: 'back.out(1.6)' }, 0.1);
    tl.from('[data-crew]', { yPercent: 30, opacity: 0, duration: 1.1, ease: 'power3.out' }, 0.45);
    tl.from('.strip-track', { xPercent: -60, opacity: 0, duration: 0.9, ease: 'power3.out' }, 0.9);
    if (matchMedia('(pointer: fine)').matches) {
      const layers = [['[data-word]', -28], ['[data-crew]', 14], ['.hero-card', 22], ['.hero-pol', 34]] as const;
      const movers = layers.map(([sel, depth]) => ({ x: gsap.quickTo(sel, 'x', { duration: 0.9, ease: 'power3' }), y: gsap.quickTo(sel, 'y', { duration: 0.9, ease: 'power3' }), depth }));
      document.querySelector('.hero')!.addEventListener('pointermove', (e) => {
        const ev = e as PointerEvent; const nx = ev.clientX / innerWidth - 0.5; const ny = ev.clientY / innerHeight - 0.5;
        movers.forEach((m) => { m.x(nx * m.depth); m.y(ny * m.depth * 0.6); });
      });
    }
    tl.from('[data-drop]', { y: -260, rotation: () => gsap.utils.random(-25, 25), opacity: 0, duration: 0.9, stagger: 0.15, ease: 'back.out(1.4)' }, 0.8);
    const st = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('.hero-word', { yPercent: 30, ease: 'none', scrollTrigger: st });
    gsap.to('.hero-pol', { yPercent: -30, ease: 'none', scrollTrigger: st });
    gsap.from('.door', { y: 120, opacity: 0, rotation: () => gsap.utils.random(-12, 12), duration: 0.9, stagger: 0.12, ease: 'back.out(1.3)', scrollTrigger: { trigger: '.door-grid', start: 'top 80%' } });
  }
  allBasics();
</script>
