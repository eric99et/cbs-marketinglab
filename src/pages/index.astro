---
import Base from '../layouts/Base.astro';
import { img, url, partners, past } from '../data/site';
const latest = past[0];
---
<Base page="home" theme="paper">
  <!-- HERO: clean split. Words left, collage right, nothing on top of the words -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        <span class="line" data-split>Marketers</span>
        <span class="line" data-split>in the</span>
        <span class="line accent" data-split>making.</span>
      </h1>
      <p class="hero-lede">A student organisation at Copenhagen Business School where curious marketers meet the brands and agencies shaping the industry.</p>
      <div class="hero-cta">
        <a class="btn" href={url('events/')}>See our events</a>
        <a class="btn ghost" href={url('partners/')}>For companies</a>
      </div>
    </div>

    <div class="collage" aria-hidden="true">
      <figure class="pol p1" data-drop><img src={img('dinner')} alt="" /></figure>
      <figure class="pol p2 bw" data-drop><img src={img('listening')} alt="" /></figure>
      <p class="hand note">some of us already made it</p>
    </div>
  </section>

  <!-- PARTNERS: slim rolling strip -->
  <section class="strip" aria-label="Brands we've worked with">
    <p class="strip-label">Worked with</p>
    <div class="strip-window" aria-hidden="true">
      <div class="strip-track">
        {[...partners, ...partners].map((p) => <span>{p}</span>)}
      </div>
    </div>
    <ul class="visually-hidden">{partners.map((p) => <li>{p}</li>)}</ul>
  </section>

  <!-- BIG WORD: cut-out crew standing in front of a giant word -->
  <section class="bigword" aria-label="Marketing, by students">
    <p class="bw-word" aria-hidden="true" data-bw-word>Marketing</p>
    <img class="bw-crew" src={img('cutout-crew')} alt="Three students laughing around laptops" loading="lazy" data-bw-crew />
  </section>

  <!-- DOORS: one door per page, each in that page's style -->
  <section class="doors wrap" aria-labelledby="doors-title">
    <h2 id="doors-title" class="doors-title">Pick a door.</h2>
    <p class="hand doors-note">(they're all good doors)</p>
    <div class="door-grid">
      <a class="door door-about" href={url('about/')}>
                <strong>Since 2012.</strong>
        <span class="door-line">Turning CBS students into people brands call back.</span>
        <span class="door-go">read the story →</span>
      </a>
      <a class="door door-events" href={url('events/')}>
        <span class="hand door-ticket">admit one ✶</span>
        <strong>Things you'll regret skipping</strong>
        <img src={img(latest.photo)} alt="" loading="lazy" />
        <span class="door-go">see the highlight reel →</span>
      </a>
      <a class="door door-partners" href={url('partners/')}>
                <strong>Got a brief?</strong>
        <span class="stickers" aria-hidden="true"><i>Bold</i><i>L'Oréal</i><i>DEPT</i><i>+8</i></span>
        <span class="door-go">meet the brands →</span>
      </a>
      <a class="door door-join" href={url('join/')}>
        <span class="hand door-hand">why join?</span>
        <span class="door-list hand">☑ real cases<br />☑ new friends<br />☐ your name here</span>
        <strong>Your CV called.</strong>
        <span class="door-go">apply →</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; min-height: 100svh; padding-block: 120px 60px; }
  .hero-title { font-size: clamp(68px, 10.5vw, 176px); line-height: 0.86; }
  .hero-title .line { display: block; overflow: hidden; }
  .hero-title .accent { color: var(--sage-dk); }
  .hero-lede { max-width: 40ch; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.5; color: var(--ink); margin-top: 28px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 32px; }
  .collage { position: relative; aspect-ratio: 4 / 5; max-height: 72vh; width: 100%; }
  .pol { position: absolute; margin: 0; background: #fff; padding: 10px 10px 34px; box-shadow: 0 14px 30px rgba(32, 32, 32, 0.16); }
  .pol img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .p1 { width: 66%; right: 0; top: 0; rotate: 4deg; }
  .p2 { width: 52%; left: 0; bottom: 4%; rotate: -5deg; }
  .bw img { filter: grayscale(1) contrast(1.08); }
  .note { position: absolute; right: 2%; bottom: 0; font-size: clamp(22px, 2.2vw, 30px); color: var(--sage-dk); rotate: -4deg; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-bottom: 40px; }
    .collage { max-height: none; width: min(100%, 420px); justify-self: center; }
  }

  /* PARTNER STRIP */
  .strip { display: flex; align-items: center; gap: 28px; padding: 18px var(--gutter); border-block: 1px solid rgba(32, 32, 32, 0.18); }
  .strip-label { flex: none; font-size: 14px; font-weight: 600; color: var(--ink-soft); }
  .strip-window { flex: 1; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .strip-track { display: flex; width: max-content; animation: strip 45s linear infinite; }
  .strip:hover .strip-track { animation-play-state: paused; }
  .strip-track span { font-size: clamp(16px, 1.4vw, 20px); font-weight: 600; letter-spacing: -0.01em; padding-inline: 28px; white-space: nowrap; position: relative; }
  .strip-track span::after { content: ''; position: absolute; right: -3px; top: 50%; width: 6px; height: 6px; border-radius: 50%; background: var(--sage); translate: 0 -50%; }
  @keyframes strip { to { translate: -50% 0; } }
  @media (max-width: 560px) { .strip-label { display: none; } }

  /* BIG WORD */
  .bigword { position: relative; overflow: hidden; background: var(--sage); margin-top: clamp(60px, 8vw, 110px); padding-top: clamp(40px, 6vw, 90px); }
  .bw-word { position: absolute; left: 0; right: 0; top: clamp(30px, 6vw, 90px); text-align: center; font-family: var(--f-display); text-transform: uppercase; font-size: 23.5vw; line-height: 0.8; color: var(--paper); letter-spacing: -0.01em; white-space: nowrap; z-index: 0; }
  .bw-crew { position: relative; z-index: 1; display: block; width: 100%; height: auto; }
  .doors { padding-top: clamp(80px, 11vw, 150px) !important; }

  /* DOORS */
  .doors { padding-block: clamp(100px, 14vw, 180px); }
  .doors-title { font-size: clamp(64px, 11vw, 180px); }
  .doors-note { font-size: 30px; color: var(--sage-dk); margin: 4px 0 50px; rotate: -2deg; }
  .door-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 32px); align-items: start; }
  .door { position: relative; display: grid; gap: 14px; min-height: 380px; padding: 24px; text-decoration: none; transition: rotate 0.3s ease, translate 0.3s ease, box-shadow 0.3s ease; box-shadow: 0 12px 26px rgba(32, 32, 32, 0.14); align-content: start; }
  .door strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(32px, 3vw, 46px); line-height: 0.92; }
  .door-go { margin-top: auto; align-self: end; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .door-ticket { font-size: 26px; color: var(--sage); }
  .door:hover { rotate: 0deg !important; translate: 0 -10px; box-shadow: 0 22px 40px rgba(32, 32, 32, 0.22); }
  .door-about { background: var(--sage); rotate: -2deg; }
  .door-about strong { font-size: clamp(48px, 5vw, 76px); }
  .door-events { background: var(--ink); color: var(--paper); rotate: 2deg; border: 2px dashed var(--sage); margin-top: 40px; }
  .door-events img { aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1); transition: filter 0.5s ease; }
  .door-events:hover img { filter: none; }
  .door-events strong { color: var(--sage); }
  .door-partners { background: var(--mauve); rotate: -1deg; }
  .stickers { display: flex; flex-wrap: wrap; gap: 8px; }
  .stickers i { font-style: normal; font-family: var(--f-display); text-transform: uppercase; padding: 8px 14px; border-radius: 999px; border: 3px solid #fff; background: var(--paper); box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15); }
  .stickers i:nth-child(2) { background: var(--postit); rotate: 6deg; }
  .stickers i:nth-child(3) { background: var(--ink); color: var(--paper); rotate: -5deg; }
  .door-join { background: #fff repeating-linear-gradient(transparent 0 31px, #cfd9e6 31px 32px); rotate: 3deg; margin-top: 20px; border-left: 2px solid rgba(192, 57, 43, 0.45); }
  .door-hand { font-size: 36px; line-height: 1; }
  .door-list { font-size: 26px; line-height: 32px; }
  @media (max-width: 1000px) { .door-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .door-grid { grid-template-columns: 1fr; } .door { min-height: 0; margin-top: 0 !important; } }
</style>

<script>
  import { gsap, reduce, splitLines, allBasics } from '../scripts/motion';
  const tl = splitLines();
  if (!reduce) {
    tl.from('[data-drop]', { y: -260, rotation: () => gsap.utils.random(-25, 25), opacity: 0, duration: 0.9, stagger: 0.12, ease: 'back.out(1.4)' }, 0.25);
    const st = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('.p1', { yPercent: -10, ease: 'none', scrollTrigger: st });
    gsap.to('.p2', { yPercent: -22, ease: 'none', scrollTrigger: st });
    gsap.fromTo('[data-bw-word]', { xPercent: 8 }, { xPercent: -8, ease: 'none', scrollTrigger: { trigger: '.bigword', start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.from('[data-bw-crew]', { yPercent: 18, ease: 'none', scrollTrigger: { trigger: '.bigword', start: 'top bottom', end: 'bottom bottom', scrub: true } });
    gsap.from('.door', { y: 120, opacity: 0, rotation: () => gsap.utils.random(-12, 12), duration: 0.9, stagger: 0.12, ease: 'back.out(1.3)', scrollTrigger: { trigger: '.door-grid', start: 'top 80%' } });
  }
  allBasics();
</script>
