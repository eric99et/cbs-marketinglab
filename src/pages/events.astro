---
// EVENTS: dark room. Gig-poster wall that scrolls sideways, photos develop as they pass.
import Base from '../layouts/Base.astro';
import NextUp from '../components/NextUp.astro';
import Arrow from '../components/Arrow.astro';
import { img, upcoming, past, socials, gcal, url } from '../data/site';

const eventSchema = past
  .filter((e) => /^\d{2}\.\d{2}\.\d{4}$/.test(e.date))
  .map((e) => {
    const [d, m, y] = e.date.split('.');
    return {
      '@context': 'https://schema.org', '@type': 'Event', name: e.title, description: e.blurb,
      startDate: `${y}-${m}-${d}`, eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: e.place, address: { '@type': 'PostalAddress', addressLocality: 'Copenhagen', addressCountry: 'DK' } },
      organizer: { '@type': 'Organization', name: 'CBS MarketingLab' },
      performer: { '@type': 'Organization', name: e.with },
    };
  });
// "Add to calendar" links for upcoming events (date as YYYY-MM-DD, time HH:MM)
---
<Base page="events" theme="mist" title="Marketing events at CBS | CBS MarketingLab" description="Case nights, panel debates and speaker events at Copenhagen Business School with brands like Bold Scandinavia, Nielsen and Arla. See what is next and what we have done." schema={eventSchema}>
  <section class="wrap page-top head">
    <h1 class="page-title">
      <span class="line" data-split>Things you'll</span>
      <span class="line" data-split>regret <span class="strike">missing</span></span>
    </h1>
    <p class="hand fix" aria-hidden="true">skipping*</p>
    <p class="lede">Talks, dinners, case nights and the occasional agency simulation. Hosted with brands that actually show up.</p>
  </section>

  <section class="next wrap" aria-labelledby="next-title">
    <article class="ticket" data-ticket>
      <div class="stub mono" aria-hidden="true"><span>admit</span><span>one</span><span>✶</span></div>
      <div class="ticket-body">
        <p class="hand next-up">next up</p>
        {upcoming.length ? (
          <>
            <h2 id="next-title">{upcoming[0].title}</h2>
            <p class="mono">{upcoming[0].date} · {upcoming[0].place}</p>
            <a class="btn" href={gcal(upcoming[0] as any)} target="_blank" rel="noopener">Lock it in (add to calendar)</a>
          </>
        ) : (
          <>
            <h2 id="next-title">Coming soon</h2>
            <p class="hand">we're cooking something. free pizza (probably)</p>
            <a class="btn" href={socials[0].href} target="_blank" rel="noopener">Get notified on Instagram ↗</a>
          </>
        )}
      </div>
    </article>
  </section>

  <section class="wall" aria-labelledby="wall-title">
    <div class="wall-pin" data-hscroll>
      <div class="wrap">
        <h2 id="wall-title" class="wall-title">The highlight reel <span class="hand" aria-hidden="true">scroll <Arrow /></span></h2>
      </div>
      <div class="track" data-track>
        {past.map((e, i) => (
          <article class={`poster tone-${e.tone}`} style={`--r:${i % 2 ? 1.2 : -1}deg`}>
            <div class="poster-img"><img src={img(e.photo)} alt={`${e.title} with ${e.with}`} loading="lazy" /></div>
            <p class="poster-date">{e.date} · {e.place}</p>
            <h3>{e.title}</h3>
            <p class="poster-blurb">{e.blurb}</p>
            <p class="poster-with">with {e.with}</p>
          </article>
        ))}
        <div class="end hand"><Arrow dir="left" /> more photos<br />coming soon.</div>
      </div>
    </div>
  </section>

  <p class="wrap footnote">* "missing" felt too polite.</p>
  <NextUp href={url('partners/')} label="Partners" note="for companies" />
</Base>

<style>
  .head { position: relative; }
  .strike { position: relative; color: var(--mauve); }
  .strike::after { content: ''; position: absolute; left: -2%; right: -2%; top: 50%; height: 0.08em; background: var(--mauve); rotate: -2deg; transform-origin: left; scale: var(--s, 0) 1; transition: scale 0.6s ease 0.9s; }
  body.is-loaded .strike { --s: 1; }
  .fix { font-size: clamp(40px, 6vw, 90px); color: var(--mauve); rotate: -2deg; margin: -0.3em 0 0 clamp(120px, 30vw, 520px); opacity: var(--f, 0); transition: opacity 0.4s ease 1.4s; }
  body.is-loaded .fix { --f: 1; }
  .head .lede { margin-top: clamp(50px, 6vw, 90px); color: var(--ink-soft); }

  .next { padding-block: clamp(50px, 7vw, 90px); }
  .ticket { display: grid; grid-template-columns: 90px 1fr; max-width: 760px; background: var(--mauve-lt); color: var(--ink); rotate: -1.2deg; box-shadow: 0 10px 24px rgba(32, 32, 32, 0.12); }
  .stub { display: grid; place-content: center; gap: 10px; text-align: center; border-right: 3px dashed var(--ink); writing-mode: vertical-rl; rotate: 180deg; font-size: 16px; letter-spacing: 0.3em; }
  .ticket-body { padding: 30px 34px 34px; display: grid; gap: 12px; justify-items: start; }
  .ticket h2 { font-size: clamp(48px, 6vw, 88px); }
  .ticket .hand { font-size: 28px; }

  .wall-pin { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: 100px 40px; overflow: hidden; }
  .wall-title { font-size: clamp(40px, 5vw, 72px); color: var(--ink); display: flex; gap: 20px; align-items: baseline; }
  .wall-title .hand { color: var(--mauve); font-size: 0.5em; text-transform: none; }
  .next-up { font-size: 26px; }
  .track { display: flex; gap: clamp(28px, 3vw, 48px); align-items: flex-start; padding: 30px var(--gutter) 10px; width: max-content; }
  .poster { width: clamp(220px, min(24vw, calc((100svh - 470px) * 0.8)), 340px); padding: 14px 14px 22px; background: var(--paper); color: var(--ink); rotate: var(--r); box-shadow: 0 10px 24px rgba(32, 32, 32, 0.12); flex: none; transition: rotate 0.3s ease, translate 0.3s ease; }
  .poster:hover { rotate: 0deg; translate: 0 -8px; }
  .poster.tone-sage { background: var(--sage-lt); }
  .poster.tone-mauve { background: var(--mauve-lt); }
  .poster-img { overflow: hidden; aspect-ratio: 4 / 5; background: #111; }
  .poster-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.55); scale: 1.08; transition: filter 0.8s ease, scale 0.8s ease; }
  .poster:hover .poster-img img, .poster.is-developed .poster-img img { filter: none; scale: 1; }
  .poster-date { margin-top: 14px; font-size: 14px; font-weight: 600; }
  .poster h3 { font-size: clamp(26px, 2.4vw, 34px); margin-top: 6px; }
  .poster-blurb { font-size: 15px; margin-top: 8px; color: var(--ink-soft); }
  .poster-with { margin-top: 10px; font-size: 14px; color: var(--ink-soft); }
  .end { flex: none; width: 260px; font-size: 40px; color: var(--mauve); }
  .footnote { padding-bottom: 60px; font-size: 14px; color: var(--ink-soft); }
  @media (max-width: 900px) {
    .wall-pin { min-height: 0; }
    .track { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 40px; }
    .track > * { scroll-snap-align: center; }
    .poster-img img { filter: grayscale(1); }
    .ticket { grid-template-columns: 60px 1fr; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduce, splitLines, allBasics } from '../scripts/motion';
  splitLines();
  requestAnimationFrame(() => document.body.classList.add('is-loaded'));
  if (!reduce) {
    gsap.from('[data-ticket]', { y: 80, rotation: 8, opacity: 0, duration: 1, delay: 0.6, ease: 'back.out(1.5)' });
    const mm = gsap.matchMedia();
    mm.add('(min-width: 901px)', () => {
      const track = document.querySelector<HTMLElement>('[data-track]')!;
      const distance = () => track.scrollWidth - window.innerWidth;
      const tween = gsap.to(track, { x: () => -distance(), ease: 'none', scrollTrigger: { trigger: '[data-hscroll]', start: 'top top', end: () => `+=${distance()}`, pin: true, scrub: 0.6, invalidateOnRefresh: true } });
      track.querySelectorAll<HTMLElement>('.poster').forEach((p) => {
        ScrollTrigger.create({ trigger: p, containerAnimation: tween, start: 'left 75%', end: 'right 25%', toggleClass: 'is-developed' });
      });
    });
  }
  allBasics();
</script>
