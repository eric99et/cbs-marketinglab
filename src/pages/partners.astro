---
// PARTNERS: cream, brand colours. A clean grid of partner names.
import Base from '../layouts/Base.astro';
import NextUp from '../components/NextUp.astro';
import { partners, img, PARTNER_EMAIL, MEMBERS, board, url } from '../data/site';
const head = board.find((b) => b.key === 'partnerships')!;
const formats = [
  { n: 'A', title: 'Case work', tag: 'Insight', text: 'Workshops and case competitions built around a live brief from your brand. Student teams dig in, develop concepts and pitch them back to you.', role: 'set the brief, coach the teams, judge the final pitches' },
  { n: 'B', title: 'Panel debates', tag: 'Thought leadership', text: 'Moderated debates on the questions the industry is still arguing about, with an audience that is encouraged to push back.', role: 'take a seat on the panel and set the agenda with us' },
  { n: 'C', title: 'Speaker events', tag: 'Visibility', text: 'One speaker, one story: a campaign, a rebrand or a career, told by the person who lived it. Then open Q&A and networking.', role: 'tell the story behind your work, then meet the room' },
];
const packages = [
  { span: 'One event', name: 'Event partner', line: 'Own one speaker event, debate or case workshop.', items: ['Co-branded event', 'Speaking or panel slot', 'Logo on posters and promotion', 'Event photography'] },
  { span: 'One semester', name: 'Semester partner', line: 'A case and a stage, across one semester.', items: ['Co-branded event with a speaking slot', 'Your logo on all our materials', 'Partner mention at all our events', 'Event photography'] },
  { span: 'Full year', name: 'Main partner', line: 'Our headline partner, one per year.', items: ['Everything in Semester partner', 'A flagship event in your name', 'Your logo on all our events and channels', 'First pick of dates and formats'] },
];
const subject = encodeURIComponent('Partnership with MarketingLab');
---
<Base page="partners" theme="paper" title="Partner with CBS students | CBS MarketingLab" description="Partner with CBS MarketingLab: run a case, join a panel debate or host a speaker event for marketing students at Copenhagen Business School. Event, semester and main partner packages.">
  <section class="page-top top" aria-labelledby="p-title">
    <div class="wrap">
      <h1 id="p-title" class="title">
        <span class="line" data-split>Brands that took</span>
        <span class="line" data-split>a chance on us</span>
      </h1>
      <p class="hand aside">(and liked it)</p>
    </div>
    <div class="wrap"><ul class="logos">
      {partners.map((p, i) => <li class={`t${i % 4}`}>{p}</li>)}
      <li class="you"><a href={`mailto:${PARTNER_EMAIL}?subject=${subject}`}>Your brand?</a></li>
    </ul></div>
  </section>

  <section class="pitch" aria-labelledby="pitch-title">
   <div class="wrap">
    <div class="pitch-head">
      <h2 id="pitch-title" class="pitch-title">Got a brief? We've got a room full of hungry marketers.</h2>
      <figure class="pitch-pol" aria-hidden="true"><img src={img('stock-workshop')} alt="" loading="lazy" /><figcaption class="hand">your brief, our whiteboard</figcaption></figure>
    </div>
    <ol class="formats">
      {formats.map((f) => (
        <li>
          <span class="f-n">{f.n}</span>
          <h3>{f.title}<small>{f.tag}</small></h3>
          <p>{f.text} <em>Your role: {f.role}.</em></p>
        </li>
      ))}
    </ol>
    <dl class="numbers">
      <div><dt>members, five teams</dt><dd>{MEMBERS}</dd></div>
      <div><dt>brands so far</dt><dd>{partners.length}</dd></div>
      <div><dt>event formats</dt><dd>3</dd></div>
    </dl>
    <h3 class="pk-title">Ways to partner</h3>
    <ul class="packages">
      {packages.map((k, i) => (
        <li class={`pk pk${i}`}>
          <span class="pk-span">{k.span}</span>
          <strong>{k.name}</strong>
          <p>{k.line}</p>
          <ul>{k.items.map((it) => <li>{it}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="fee">Every partnership includes a fee that depends on the format and is always open to discussion. Tell us what you want to achieve, and we come back with a concept built around it.</p>
    <div class="cta">
      <a class="btn big-btn" href={`mailto:${PARTNER_EMAIL}?subject=${subject}`}>Let's talk ↗</a>
      <p class="contact-line"><strong>{head.name}</strong>, {head.role}<br /><a href={`mailto:${PARTNER_EMAIL}`}>{PARTNER_EMAIL}</a></p>
    </div>
   </div>
  </section>
  <NextUp href={url('join/')} label="Join us" note="for students" />
</Base>

<style>
  .top { padding-bottom: clamp(50px, 7vw, 100px); overflow: hidden; }
  .title { font-size: clamp(56px, 9vw, 150px); line-height: 0.86; }
  .title .line { display: block; overflow: hidden; }
  .aside { font-size: clamp(40px, 4.4vw, 66px); color: var(--mauve); rotate: -1.8deg; margin: 4px 0 0 clamp(0px, 20vw, 380px); }
  .logos { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(22px, 2.6vw, 38px) clamp(16px, 2vw, 28px); }
  .logos li { position: relative; padding: 18px 26px 16px; background: #fff; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(26px, 2.6vw, 40px); line-height: 1; box-shadow: 0 10px 24px rgba(32, 32, 32, 0.1); transition: rotate 0.25s ease, translate 0.25s ease; }
  .logos li::before { content: ''; position: absolute; top: -11px; left: 50%; width: 64px; height: 22px; translate: -50% 0; rotate: -3deg; background: var(--tape); }
  .logos .t0 { rotate: -1.5deg; } .logos .t1 { rotate: 1deg; background: var(--sage-lt); } .logos .t2 { rotate: -0.5deg; } .logos .t3 { rotate: 1.5deg; background: var(--mauve-lt); }
  .logos li:hover { rotate: 0deg; translate: 0 -4px; }
  .logos .you { background: var(--ink); color: var(--paper); rotate: -1deg; }
  .logos .you a { text-decoration: none; color: inherit; }

  .pitch { padding-block: clamp(70px, 10vw, 130px) clamp(80px, 11vw, 150px); background: var(--sage-xl); color: var(--ink); border-top: 2px solid var(--ink); }
  .pitch-head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(30px, 5vw, 70px); align-items: center; }
  .pitch-pol { margin: 0; background: #fff; padding: 12px 12px 14px; rotate: 1.8deg; box-shadow: 0 10px 24px rgba(32, 32, 32, 0.12); }
  .pitch-pol img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .pitch-pol figcaption { font-size: 26px; color: var(--mauve); margin-top: 6px; }
  @media (max-width: 900px) { .pitch-head { grid-template-columns: 1fr; } }
  .pitch-title { font-size: clamp(44px, 6vw, 96px); max-width: 14ch; }
  .formats { list-style: none; padding: 0; margin: 50px 0 0; border-top: 3px solid var(--ink); }
  .formats li { display: grid; grid-template-columns: 90px minmax(0, 1fr) minmax(0, 1.3fr); gap: 24px; align-items: baseline; padding: 24px 0; border-bottom: 3px solid var(--ink); transition: padding 0.2s ease, background 0.2s ease; }
  .formats li:hover { background: var(--mauve-lt); padding-inline: 16px; }
  .f-n { font-family: var(--f-display); font-size: 72px; line-height: 0.8; color: var(--mauve); }
  .formats h3 { font-size: clamp(34px, 3.6vw, 56px); }
  .formats p { font-size: 18px; }
  .formats em { font-style: normal; font-weight: 600; }
  .numbers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 50px 0 0; }
  .numbers dt { font-size: 16px; }
  .numbers dd { margin: 6px 0 0; font-family: var(--f-display); font-size: clamp(48px, 6vw, 96px); line-height: 0.9; }
  .formats small { display: block; font-family: var(--f-hand); font-size-adjust: 0.4; line-height: 1.05; text-transform: none; font-size: 30px; line-height: 1; color: var(--mauve); margin-top: 6px; }
  .pk-title { font-size: clamp(44px, 5vw, 80px); margin-top: clamp(70px, 9vw, 120px); }
  .packages { list-style: none; padding: 0; margin: 30px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); align-items: stretch; }
  .pk { border: 3px solid var(--ink); padding: 24px 24px 28px; display: grid; gap: 10px; align-content: start; box-shadow: 8px 8px 0 var(--ink); }
  .pk0 { background: var(--paper); }
  .pk1 { background: var(--mauve-lt); }
  .pk2 { background: var(--ink); color: var(--paper); box-shadow: 8px 8px 0 var(--sage); }
  .pk-span { font-family: var(--f-hand); font-size-adjust: 0.4; line-height: 1.05; font-size: 30px; line-height: 1; color: var(--mauve); }
  .pk2 .pk-span { color: var(--sage); }
  .pk strong { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(34px, 3.2vw, 50px); line-height: 0.95; }
  .pk ul { margin: 6px 0 0; padding-left: 18px; display: grid; gap: 4px; font-size: 16px; }
  .fee { max-width: 62ch; margin-top: 36px; font-size: 17px; }
  .contact-line { font-size: 16px; line-height: 1.5; }
  .contact-line a { text-underline-offset: 4px; }
  @media (max-width: 900px) { .packages { grid-template-columns: 1fr; } }
  .cta { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; margin-top: 56px; }
  .big-btn { font-size: 20px; padding: 20px 30px; box-shadow: 8px 8px 0 var(--mauve); }
  .big-btn:hover { box-shadow: 12px 12px 0 var(--mauve); }
  .pitch .cta .hand { color: var(--mauve); font-size: 28px; }
  .cta .hand { font-size: 28px; }
  @media (max-width: 900px) {
    .formats li { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { gsap, reduce, splitLines, allBasics} from '../scripts/motion';
  splitLines();
  if (!reduce) {
    gsap.from('.logos li', { y: -40, rotation: () => gsap.utils.random(-12, 12), duration: 0.6, stagger: 0.05, ease: 'back.out(1.6)', delay: 0.3 });
    gsap.from('.pk', { y: 80, rotation: (i) => [-6, 3, 7][i], duration: 0.9, stagger: 0.12, ease: 'back.out(1.4)', scrollTrigger: { trigger: '.packages', start: 'top 85%' } });
  }
  allBasics();
</script>
